# Copia este archivo como .env y completa los valores. NUNCA subas .env a Git.

# Base de datos (MySQL en la misma EC2, o RDS: usar su endpoint en DB_HOST)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sgr_laserena_db
# Usuario propio de la aplicación, NO root (ver README: creación de usuario)
DB_USER=sgr_app
DB_PASSWORD=

# Servidor
PORT=3000
NODE_ENV=production

# Sesión: OBLIGATORIO, mínimo 16 caracteres. Genera uno con:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRA=8h

# Correo para enviar el código de recuperación (si no se configura, en producción NO se envían códigos)
# Gmail: usar una "clave de aplicación" (requiere verificación en dos pasos), no la clave normal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SGR Municipalidad de La Serena <no-responder@laserena.cl>"

# Recuperación de contraseña (valores por defecto)
RECUPERACION_VIGENCIA_MIN=10
RECUPERACION_ESPERA_SEG=45
RECUPERACION_MAX_POR_HORA=5
